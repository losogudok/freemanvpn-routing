{
  "remnawave": {
    "injectHosts": [
      {
        "selector": {
          "type": "sameTagAsRecipient"
        },
        "tagPrefix": "proxy"
      }
    ]
  },
  "dns": {
    "servers": [
      {
        "address": "https://77.88.8.8/dns-query",
        "domains": [
          "geosite:private",
          "geosite:category-ru",
          "geosite:whitelist",
          "geosite:apple",
          "geosite:epicgames",
          "geosite:riot",
          "geosite:escapefromtarkov",
          "geosite:steam",
          "geosite:twitch",
          "geosite:pinterest",
          "geosite:faceit",
          "geosite:blizzard",
          "geosite:ip-checkers"
        ],
        "skipFallback": true
      },
      "https://8.8.8.8/dns-query"
    ],
    "hosts": {
      "lkfl2.nalog.ru": "213.24.64.175",
      "lknpd.nalog.ru": "213.24.64.181"
    },
    "queryStrategy": "UseIP",
    "disableFallbackIfMatch": true
  },
  "fakeDns": {
    "ipPool": "198.18.0.0/15",
    "poolSize": 65535
  },
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "domainMatcher": "hybrid",
    "rules": [
      {
        "domain": [
          "geosite:win-spy",
          "geosite:torrent",
          "geosite:category-ads"
        ],
        "outboundTag": "block"
      },
      {
        "domain": [
          "geosite:google-play",
          "geosite:github",
          "geosite:twitch-ads",
          "geosite:youtube",
          "geosite:telegram"
        ],
        "outboundTag": "proxy"
      },
      {
        "domain": [
          "geosite:private",
          "geosite:category-ru",
          "geosite:whitelist",
          "geosite:apple",
          "geosite:epicgames",
          "geosite:riot",
          "geosite:escapefromtarkov",
          "geosite:steam",
          "geosite:twitch",
          "geosite:pinterest",
          "geosite:faceit",
          "geosite:blizzard",
          "geosite:ip-checkers"
        ],
        "outboundTag": "direct"
      },
      {
        "ip": [
          "geoip:private",
          "geoip:direct",
          "geoip:blizzard"
        ],
        "outboundTag": "direct"
      },
      {
        "network": "tcp,udp",
        "outboundTag": "proxy"
      }
    ]
  },
  "inbounds": [
    {
      "tag": "socks",
      "port": 10808,
      "listen": "127.0.0.1",
      "protocol": "socks",
      "settings": {
        "udp": true
      },
      "sniffing": {
        "enabled": true,
        "routeOnly": false,
        "destOverride": [
          "fakedns",
          "http",
          "tls",
          "quic"
        ]
      }
    },
    {
      "tag": "http",
      "port": 10809,
      "listen": "127.0.0.1",
      "protocol": "http",
      "settings": {
        "allowTransparent": false
      },
      "sniffing": {
        "enabled": true,
        "routeOnly": false,
        "destOverride": [
          "fakedns",
          "http",
          "tls",
          "quic"
        ]
      }
    }
  ],
  "outbounds": [
    {
      "tag": "direct",
      "protocol": "freedom"
    },
    {
      "tag": "block",
      "protocol": "blackhole"
    }
  ]
}
