{
  "remnawave": {
    "addVirtualHostAsOutbound": true
  },
  "dns": {
    "tag": "dns-queries",
    "servers": [
      {
        "address": "https://77.88.8.8/dns-query",
        "domains": [
          "domain:ru",
          "domain:su",
          "domain:xn--p1ai",
          "geosite:category-ru",
          "geosite:whitelist",
          "geosite:ip-checkers"
        ],
        "skipFallback": true
      },
      "https://8.8.8.8/dns-query"
    ],
    "hosts": {
      "lkfl2.nalog.ru": "213.24.64.175",
      "lknpd.nalog.ru": "213.24.64.181"
    },
    "queryStrategy": "UseIP",
    "disableFallbackIfMatch": true
  },
  "fakeDns": {
    "ipPool": "198.18.0.0/15",
    "poolSize": 65535
  },
  "routing": {
    "domainStrategy": "IPOnDemand",
    "domainMatcher": "hybrid",
    "rules": [
      {
        "inboundTag": [
          "dns-queries"
        ],
        "ip": [
          "77.88.8.8/32"
        ],
        "port": "443",
        "outboundTag": "proxy"
      },
      {
        "inboundTag": [
          "dns-queries"
        ],
        "network": "tcp,udp",
        "outboundTag": "direct"
      },
      {
        "domain": [
          "geosite:private"
        ],
        "outboundTag": "direct"
      },
      {
        "domain": [
          "domain:ru",
          "domain:su",
          "domain:xn--p1ai",
          "geosite:category-ru",
          "geosite:whitelist",
          "geosite:ip-checkers"
        ],
        "outboundTag": "proxy"
      },
      {
        "ip": [
          "geoip:private"
        ],
        "outboundTag": "direct"
      },
      {
        "ip": [
          "geoip:direct",
          "geoip:whitelist"
        ],
        "outboundTag": "proxy"
      },
      {
        "network": "tcp,udp",
        "outboundTag": "direct"
      }
    ]
  },
  "inbounds": [
    {
      "tag": "socks",
      "port": 10808,
      "listen": "127.0.0.1",
      "protocol": "socks",
      "settings": {
        "udp": true
      },
      "sniffing": {
        "enabled": true,
        "routeOnly": false,
        "destOverride": [
          "fakedns",
          "http",
          "tls",
          "quic"
        ]
      }
    },
    {
      "tag": "http",
      "port": 10809,
      "listen": "127.0.0.1",
      "protocol": "http",
      "settings": {
        "allowTransparent": false
      },
      "sniffing": {
        "enabled": true,
        "routeOnly": false,
        "destOverride": [
          "fakedns",
          "http",
          "tls",
          "quic"
        ]
      }
    }
  ],
  "outbounds": [
    {
      "tag": "direct",
      "protocol": "freedom"
    }
  ]
}
