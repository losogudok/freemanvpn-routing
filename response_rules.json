{
  "version": "1",
  "rules": [
    {
      "name": "Browser Subscription",
      "description": "System critical: do not delete or disable this rule.",
      "enabled": true,
      "operator": "AND",
      "conditions": [
        {
          "headerName": "accept",
          "operator": "CONTAINS",
          "value": "text/html",
          "caseSensitive": true
        }
      ],
      "responseType": "BROWSER"
    },
    {
      "name": "Xray Checker",
      "description": "Allow xray-checker to get a subscription",
      "enabled": true,
      "operator": "AND",
      "conditions": [
        {
          "headerName": "user-agent",
          "operator": "CONTAINS",
          "value": "xray-checker",
          "caseSensitive": false
        }
      ],
      "responseType": "XRAY_BASE64"
    },
    {
      "name": "HAPP",
      "description": "Allow HAPP to get a subscription",
      "enabled": true,
      "operator": "AND",
      "conditions": [
        {
          "headerName": "user-agent",
          "operator": "CONTAINS",
          "value": "happ",
          "caseSensitive": false
        }
      ],
      "responseType": "XRAY_JSON",
      "responseModifications": {
        "headers": [
          {
            "key": "ping-type",
            "value": "tcp"
          },
          {
            "key": "routing",
            "value": "happ:"
          }
        ],
        "applyHeadersToEnd": true
      }
    },
    {
      "name": "INCY",
      "description": "Allow INCY to get a subscription",
      "enabled": true,
      "operator": "AND",
      "conditions": [
        {
          "headerName": "user-agent",
          "operator": "CONTAINS",
          "value": "incy",
          "caseSensitive": false
        }
      ],
      "responseType": "XRAY_BASE64",
      "responseModifications": {
        "headers": [
          {
            "key": "routing",
            "value": "incy:"
          }
        ],
        "applyHeadersToEnd": true,
        "ignoreServeJsonAtBaseSubscription": true,
        "excludeHostsByTags": ["INCY_EXCLUDE"]
      }
    },
    {
      "name": "V2RAYTUN",
      "description": "Allow V2RAYTUN to get a subscription",
      "enabled": true,
      "operator": "AND",
      "conditions": [
        {
          "headerName": "user-agent",
          "operator": "CONTAINS",
          "value": "v2raytun",
          "caseSensitive": false
        }
      ],
      "responseType": "XRAY_JSON"
    },
    {
      "name": "V2RAYN",
      "description": "Allow V2RAYN to get a subscription",
      "enabled": true,
      "operator": "AND",
      "conditions": [
        {
          "headerName": "user-agent",
          "operator": "CONTAINS",
          "value": "v2rayn",
          "caseSensitive": false
        }
      ],
      "responseType": "XRAY_JSON"
    },
    {
      "name": "THRONE",
      "description": "Allow THRONE to get a subscription",
      "enabled": true,
      "operator": "AND",
      "conditions": [
        {
          "headerName": "user-agent",
          "operator": "CONTAINS",
          "value": "throne",
          "caseSensitive": false
        }
      ],
      "responseType": "XRAY_JSON"
    },
    {
      "name": "Fallback Base64",
      "description": "System critical: do not delete or disable this rule.",
      "enabled": true,
      "operator": "AND",
      "conditions": [],
      "responseType": "XRAY_BASE64"
    }
  ]
}
